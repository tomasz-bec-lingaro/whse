APP_ENV=production
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:5432/<database>
AZURE_STORAGE_CONNECTION_STRING=<store-in-secret-manager-or-ci-secret>
AZURE_STORAGE_CONTAINER_NAME=delivery-documents
MAX_UPLOAD_SIZE_MB=10
UPLOAD_RATE_LIMIT_PER_MINUTE=30
UPLOAD_RATE_LIMIT_WINDOW_SECONDS=60
CORS_ALLOWED_ORIGINS=https://whs.example.com
API_KEY=<store-in-secret-manager-or-ci-secret>
API_KEY_ROLES=whs:operator
